# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# None of these values reach the browser bundle (Vite only exposes VITE_* variables, and none are used).

# development | production | test
NODE_ENV=development

# Port for the Express API (Vite proxies /api here in development).
PORT=4000

# MongoDB connection string. Transactions require a replica set.
# Local Docker (see docker-compose.yml):
MONGODB_URI=mongodb://localhost:27017/stockflow?replicaSet=rs0&directConnection=true
# MongoDB Atlas alternative:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stockflow?retryWrites=true&w=majority

# Long random string used to sign session cookies (32+ characters required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Absolute session lifetime in minutes (default 480 = 8 hours).
SESSION_TTL_MINUTES=480

# Failed sign-in attempts allowed per IP + email per 15 minutes.
LOGIN_RATE_LIMIT=10

# Only needed if the frontend is served from a different origin than the API (comma-separated).
# Leave empty for the recommended same-origin setup.
CORS_ORIGINS=

# Number of reverse proxies in front of the app (sets Express "trust proxy"; needed for secure cookies behind HTTPS proxies).
# Defaults to 1 in production.
# TRUST_PROXY=1

# Enables the admin-only "Reset to sample data" tool. Ignored when NODE_ENV=production.
ALLOW_DEV_RESET=false
