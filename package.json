{
  "name": "webapp-duo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/start.js",
    "lint": "oxlint",
    "test": "npm run test:api",
    "test:api": "node --test --test-concurrency=1 --test-timeout=120000 \"server/tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test:api && npm run build && npm run test:e2e",
    "seed": "node server/scripts/seed.js",
    "create-admin": "node server/scripts/create-admin.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "preview": "vite preview"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "@tailwindcss/vite": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.71.0",
    "mongoose": "^8.24.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.90.0",
    "supertest": "^7.3.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
